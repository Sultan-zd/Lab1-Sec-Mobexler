# ============================================
# Lab 1 - Mobexler Setup .gitignore
# ============================================

# OVA / VM images (too large for Git)
*.ova
*.ovf
*.vmdk
*.vdi
*.vhd
*.vhdx
*.box

# VirtualBox logs and state
*.vbox-prev
*.log
Logs/

# VMware files
*.vmx
*.vmxf
*.vmsd
*.vmsn
*.nvram
*.vmem
*.vmss

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.bak
*.orig
